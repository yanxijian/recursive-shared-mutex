# Line endings and text handling - the standard, declared once.
#
# Policy:
#   * C/C++ sources keep UTF-8 BOM + CRLF (see AGENTS.md R1). `-text -eol` means git
#     never converts them, so the bytes on disk are the bytes in the object store.
#   * Everything else is LF in the repository AND on checkout - that is what
#     `text=auto eol=lf` means, and it matches .editorconfig's [*] default.
#   * Windows batch files are CRLF in the object store and on checkout, the same
#     rule as C/C++ - cmd.exe expects CRLF, and one mechanism beats two.
#
# The vendored RepoRules checker (`scripts/repo_rules.py`, configured in repo-rules.json) verifies the working tree agrees with this,
# so a stray editor or a careless rewrite cannot flip a whole file silently.

* text=auto eol=lf

# C/C++: BOM + CRLF, byte for byte, in the repository and in every checkout.
*.c   -text -eol
*.cc   -text -eol
*.cpp   -text -eol
*.cxx   -text -eol
*.h   -text -eol
*.hh   -text -eol
*.hpp   -text -eol
*.hxx   -text -eol

# Batch files: CRLF in the object store too. Same rule as C/C++ means one
# mechanism for "this file must be CRLF", and an accidental LF flip shows up as a
# real diff instead of being normalised away on commit.
*.bat   -text -eol
*.cmd   -text -eol

# Shell scripts stay LF everywhere, or the shebang breaks.
*.sh    text eol=lf
